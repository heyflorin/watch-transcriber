{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "archive-viewer-remote",
  "description": "Least-privilege permissions for the authenticated in-app loopback viewer.",
  "local": false,
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "allow-accept-local-transcript-only",
    "allow-adopt-mobile-imports",
    "allow-back-up-local-recording-to-cloud",
    "allow-cancel-processing-recording",
    "allow-capture-capabilities",
    "allow-capture-permissions",
    "allow-capture-preflight",
    "allow-capture-request-permissions",
    "allow-capture-source-icon",
    "allow-capture-sources",
    "allow-capture-status",
    "allow-confirm-import-review",
    "allow-delete-processing-credentials",
    "allow-delete-sync-credentials",
    "allow-discard-processing-recording",
    "allow-export-recording-original",
    "allow-finalize-mobile-capture",
    "allow-finalize-pending-mobile-capture",
    "allow-get-processing-preference",
    "allow-import-audio-files",
    "allow-install-local-model-pack",
    "allow-install-moss-candidate-model-pack",
    "allow-install-qwen-candidate-model-pack",
    "allow-install-speakerkit-candidate-model-pack",
    "allow-initialize-local-archive",
    "allow-list-pending-mobile-recordings",
    "allow-local-model-pack-status",
    "allow-moss-candidate-model-pack-status",
    "allow-moss-pipeline-model-status",
    "allow-install-moss-pipeline-model-pack",
    "allow-remove-moss-pipeline-model-pack",
    "allow-qwen-candidate-model-pack-status",
    "allow-speakerkit-candidate-model-pack-status",
    "allow-list-processing-recordings",
    "allow-mobile-acknowledge-shared-imports",
    "allow-mobile-check-permissions",
    "allow-mobile-drain-shared-imports",
    "allow-mobile-open-audio-picker",
    "allow-mobile-pause",
    "allow-mobile-preflight",
    "allow-mobile-request-permissions",
    "allow-mobile-resume",
    "allow-mobile-start",
    "allow-mobile-status",
    "allow-mobile-stop",
    "allow-open-capture-permission-settings",
    "allow-pause-capture",
    "allow-process-recordings",
    "allow-process-recording-with-local-models",
    "allow-process-recording-with-moss-candidate",
    "allow-process-recording-with-qwen-candidate",
    "allow-processing-credentials-status",
    "allow-reprocess-recording",
    "allow-remove-local-model-pack",
    "allow-remove-moss-candidate-model-pack",
    "allow-remove-qwen-candidate-model-pack",
    "allow-remove-speakerkit-candidate-model-pack",
    "allow-resume-capture",
    "allow-retry-processing-recording",
    "allow-runtime-features",
    "allow-save-processing-credentials",
    "allow-save-sync-credentials",
    "allow-set-processing-preference",
    "allow-start-capture",
    "allow-stop-capture",
    "allow-cancel-local-model-install",
    "allow-take-over-processing-with-local-models",
    "allow-take-over-processing-with-qwen-candidate"
  ]
}
