{
  "build": {
    "beforeBuildCommand": "./scripts/build_local_sidecars.sh",
    "beforeDevCommand": "./scripts/build_local_sidecars.sh"
  },
  "bundle": {
    "externalBin": [
      "binaries/echowall-whisper-worker",
      "binaries/echowall-diarization-worker",
      "binaries/echowall-summary-worker",
      "binaries/echowall-qwen-worker",
      "binaries/echowall-moss-worker"
