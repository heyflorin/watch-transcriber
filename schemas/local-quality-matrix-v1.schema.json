{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echowall.invalid/schemas/local-quality-matrix-v1.schema.json",
  "title": "EchoWall local quality matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "stratum",
          "duration_ms",
          "ground_truth",
          "miaoji",
          "local",
          "named_terms"
        ],
        "properties": {
          "case_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
          "stratum": {
            "enum": ["english", "mandarin", "mixed", "overlap", "long_form"]
          },
          "duration_ms": { "type": "integer", "minimum": 1, "maximum": 18000000 },
          "ground_truth": { "$ref": "#/$defs/relativeJson" },
          "miaoji": { "$ref": "#/$defs/relativeJson" },
          "local": { "$ref": "#/$defs/relativeJson" },
          "named_terms": {
            "type": "array",
            "maxItems": 256,
            "items": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        }
      }
    }
  },
  "$defs": {
    "relativeJson": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+\\.json$",
      "maxLength": 2048
    }
  }
}
