{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echowall.invalid/schemas/local-quality-transcript-v1.schema.json",
  "title": "EchoWall local quality canonical transcript v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "segments"],
  "properties": {
    "schema_version": { "const": 1 },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start_ms", "end_ms", "speaker", "text"],
        "properties": {
          "start_ms": { "type": "integer", "minimum": 0, "maximum": 17999999 },
          "end_ms": { "type": "integer", "minimum": 1, "maximum": 18000000 },
          "speaker": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
          "text": { "type": "string", "minLength": 1, "maxLength": 65536 }
        }
      }
    }
  }
}
